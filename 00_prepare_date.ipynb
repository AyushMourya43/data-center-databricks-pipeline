   "source": [
    "\n",
    "from datetime import datetime, timedelta, timezone\n",
    "\n",
    "IST = timezone(timedelta(hours=5, minutes=30))\n",
    "\n",
    "process_date = datetime.now(IST).strftime(\"%Y-%m-%d\")\n",
    "\n",
    "dbutils.jobs.taskValues.set(\n",
    "    key=\"process_date\",\n",
    "    value=process_date\n",
    ")\n",
    "\n",
    "print(\"Shared Process Date:\", process_date)\n"
   ]
  }
